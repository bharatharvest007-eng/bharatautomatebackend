# BharatAutomate backend — example environment.
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public URL of this backend (OAuth callbacks, webhooks, short links /r/:slug).
BASE_URL=http://localhost:5000
# Dashboard URL (CORS allowlist, OAuth redirects, links in notifications).
FRONTEND_URL=http://localhost:3000
# Extra comma-separated browser origins allowed to call the private API.
CORS_ORIGINS=

# --- Database ---------------------------------------------------------------
# DATABASE_URL is accepted as an alias.
MONGODB_URI=mongodb://localhost:27017/socialmediaautomate

# --- Auth & secrets ---------------------------------------------------------
# Long random strings (e.g. `openssl rand -base64 48`).
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts stored access tokens and webhook secrets. Falls back to SESSION_SECRET.
# Changing it makes previously encrypted tokens unreadable (accounts must reconnect).
ENCRYPTION_KEY=change-me-to-another-long-random-string
# 'lax' when dashboard and API share a site; 'none' for cross-site (forces Secure).
COOKIE_SAMESITE=lax
# Defaults to true in production.
COOKIE_SECURE=false

# --- AI (Anthropic Claude) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
# USD value of one AI credit (raw model cost).
AI_CREDIT_USD=0.005

# --- Billing (Razorpay) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# 'live' uses Razorpay; 'dev' simulates checkout (test mode). Defaults to 'live' only when keys are set.
BILLING_MODE=dev

# --- GST invoice supplier details -------------------------------------------
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_GSTIN=29ABCDE1234F1Z5
# Two-digit GST state code of the supplier (29 = Karnataka).
COMPANY_STATE_CODE=29
COMPANY_ADDRESS=123 Example Road, Bengaluru, Karnataka 560001
COMPANY_EMAIL=billing@example.com

# --- Meta (Facebook / WhatsApp) ---------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5000/api/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-verify-token

# --- Instagram Business Login -----------------------------------------------
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish

# --- Background jobs --------------------------------------------------------
# Set to false on extra web replicas so only one process runs the job worker.
JOBS_ENABLED=true

# --- One-off bootstrap (npm run db:init) ------------------------------------
# Creates the first owner account + workspace. Remove after use.
INIT_ADMIN_EMAIL=owner@example.com
INIT_ADMIN_PASSWORD=choose-a-strong-password
INIT_ADMIN_NAME=Workspace Owner
INIT_WORKSPACE_NAME=My Workspace
# Optional: free | starter | growth | business | enterprise (empty = 14-day Growth trial).
INIT_WORKSPACE_PLAN=
